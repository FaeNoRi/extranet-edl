# Extranet EDL+ — modèle de configuration de PRODUCTION.
# Copier en `.env` sur le serveur (jamais dans Git), remplacer chaque valeur <…>, puis `chmod 600 .env`.
# Vérifier ensuite avec : php artisan edl:preflight

APP_NAME="Extranet EDL+"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate --force (une seule fois ; à conserver, voir docs/sauvegardes.md)
APP_URL=https://<nom-de-domaine-de-l-extranet>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Europe/Paris

# Derrière le reverse proxy de l'hébergeur : adresses/CIDR séparés par des virgules, ou * (à demander à l'hébergeur).
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<base>
DB_USERNAME=<utilisateur dédié, droits limités à cette base>
DB_PASSWORD=<mot de passe long et aléatoire>
# Dossier contenant mysqldump si absent du PATH (laisser vide sinon).
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Envoi des e-mails (liens de création de mot de passe, alertes de sauvegarde) : OBLIGATOIRE.
MAIL_MAILER=smtp
MAIL_HOST=<serveur SMTP>
MAIL_PORT=587
MAIL_USERNAME=<identifiant SMTP>
MAIL_PASSWORD=<mot de passe SMTP>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="<adresse-expéditeur@domaine>"
MAIL_FROM_NAME="${APP_NAME}"

# Informations légales (mentions légales, politique de confidentialité, registre RGPD).
EDL_NDA=<n° de déclaration d'activité>
EDL_DIRECTEUR_PUBLICATION=<nom du directeur de publication>
EDL_DPO_NOM=<nom du référent RGPD>
EDL_DPO_EMAIL=<e-mail du référent RGPD>
# À renseigner (AAAA-MM-JJ) quand l'EDL a validé le registre des traitements.
EDL_REGISTRE_VALIDE_LE=

# Téléversements : doit rester ≤ upload_max_filesize et post_max_size de PHP.
EDL_UPLOAD_MAX_KO=51200

# Sauvegardes (voir docs/sauvegardes.md). Le mot de passe est à conserver HORS du serveur.
BACKUP_ARCHIVE_PASSWORD=<mot de passe long et aléatoire>
BACKUP_NOTIFICATION_EMAIL=<adresse qui reçoit les alertes d'échec>
BACKUP_OFFSITE_DISK=            # nom du disque hors serveur déclaré dans config/filesystems.php
